//		ble_layer {
//			//label = "Ble";
//			bindings = <
//				//╭──────────────┬──────────────┬──────────────┬──────────────┬──────────────╮     ╭──────────────┬──────────────┬──────────────┬──────────────┬──────────────╮
//					  xxx            xxx            xxx            xxx            xxx                  &bt BT_CLR     &bt BT_DISC    &out OUT_BLE   &out OUT_USB   &out OUT_TOG
//				//├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤     ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
//						xxx            xxx            xxx            xxx            xxx                  xxx            &bt BT_SEL 3   &bt BT_SEL 4   xxx            xxx
//				//├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤     ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
//					  &bootloader    xxx            xxx            xxx            xxx                  xxx            &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bootloader
//				//╰──────────────┴──────────────┼──────────────┼──────────────┼──────────────┤     ├──────────────┼──────────────┼──────────────┼──────────────┴──────────────╯
//																													  xxx            xxx               xxx            xxx 
//             //                                        ╰──────────────┴──────────────╯     ╰──────────────┴──────────────╯
//			>;
//		};
	};
};

